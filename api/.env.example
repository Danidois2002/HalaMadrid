# Copier ce fichier en .env pour le développement local (npm run dev).
# Sans DATABASE_URL, l'API utilise une base PostgreSQL en mémoire (PGlite) : rien à installer.

# Base de données : pglite://memory (en mémoire), pglite://.pglite (dossier local) ou URL PostgreSQL (Neon…)
DATABASE_URL=pglite://.pglite

# Secret de signature des jetons de connexion (obligatoire en production, long et aléatoire)
JWT_SECRET=

# Compte admin privé, créé ou mis à jour au démarrage (le compte démo public est toujours créé)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Sites autorisés à appeler l'API depuis un navigateur, séparés par des virgules
CORS_ORIGINS=http://localhost,http://127.0.0.1,https://danidois2002.github.io

PORT=3000
